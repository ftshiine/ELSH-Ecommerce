<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | <%= title %></title>
  
  <!-- Preload Fonts and External CSS to prevent FOUC -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/user/home-navbar.css" />
  <link rel="stylesheet" href="/css/user/footer.css" />
  <link rel="stylesheet" href="/css/admin/modal.css" />
  <link rel="stylesheet" href="/css/user/checkout-success.css" />

  <% 
    locals._homeNavbarCssLoaded = true;
    locals._footerCssLoaded = true;
  %>
</head>

<body>

  <%- include('../partials/home-navbar') %>

  <main class="success-wrapper">
    
    <div class="success-header">
      <div class="check-circle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h1>A New Ritual Begins.</h1>
      <p>Your order #<%= order.orderId %> has been confirmed. Thank you for choosing a more intentional approach to beauty and wellness.</p>
    </div>

    <div class="order-status-card">
      <div class="status-top">
        <div class="estimated-arrival">
          <span class="label">ESTIMATED ARRIVAL</span>
          <span class="date">
            <% 
              // Fake delivery date estimation for UI
              let date = new Date(order.createdAt);
              date.setDate(date.getDate() + 3);
              let end = new Date(date);
              end.setDate(end.getDate() + 2);
              
              const options = { month: 'long', day: 'numeric' };
              const startStr = date.toLocaleDateString('en-US', options);
              const endStr = end.toLocaleDateString('en-US', { day: 'numeric', year: 'numeric' });
            %>
            <%= startStr %> — <%= endStr %>
          </span>
        </div>
        <div class="truck-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
      </div>


      <div class="status-actions" style="display: flex; gap: 15px;">
        <a href="/orders/<%= order._id %>" class="btn-solid btn-track">TRACK YOUR ORDER &rarr;</a>
        <a href="/shop" class="btn-outline btn-shop">CONTINUE SHOPPING</a>
      </div>
    </div>

    <div class="order-details-grid">
      
      <div class="detail-block">
        <h5>SHIPPING ADDRESS</h5>
        <p>
          <%= order.shippingAddress.fullName %><br>
          <%= order.shippingAddress.addressLine1 %><br>
          <% if (order.shippingAddress.addressLine2) { %>
            <%= order.shippingAddress.addressLine2 %><br>
          <% } %>
          <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %><br>
          <%= order.shippingAddress.country %>
        </p>
      </div>

      <div class="detail-block">
        <h5>PAYMENT METHOD</h5>
        <p class="payment-method">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
          <%= order.paymentInfo.method === 'COD' ? 'cash on delivery' : order.paymentInfo.method %>
        </p>
      </div>

    </div>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>
