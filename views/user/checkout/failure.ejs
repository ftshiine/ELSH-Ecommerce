<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | <%= title %></title>
  
  <!-- Preload Fonts and External CSS to prevent FOUC -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/user/home-navbar.css" />
  <link rel="stylesheet" href="/css/user/footer.css" />
  <link rel="stylesheet" href="/css/admin/modal.css" />
  <link rel="stylesheet" href="/css/user/checkout-failure.css" />

  <% 
    locals._homeNavbarCssLoaded = true;
    locals._footerCssLoaded = true;
  %>
</head>

<body>

  <%- include('../partials/home-navbar') %>

  <main class="failure-wrapper">
    
    <div class="failure-header">
      <div class="x-circle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d32f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
      </div>
      <h1>Payment Unsuccessful.</h1>
      <p>Your payment for order #<%= order.orderId %> could not be completed. Your order has been saved and is currently pending.</p>
    </div>

    <div class="order-status-card">
      <div class="status-top">
        <div class="estimated-arrival">
          <span class="label">ORDER STATUS</span>
          <span class="date" style="color: #d32f2f;">PENDING PAYMENT</span>
        </div>
        <div class="truck-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </div>
      </div>

      <div class="status-actions" style="display: flex; gap: 15px;">
        <a href="/orders/<%= order._id %>" class="btn-solid btn-retry" style="background: #222; color: #fff; text-decoration: none;">RETRY PAYMENT &rarr;</a>
        <a href="/shop" class="btn-outline btn-shop" style="border: 1px solid #222; color: #222; text-decoration: none;">CONTINUE SHOPPING</a>
      </div>
    </div>

    <div class="order-details-grid">
      
      <div class="detail-block">
        <h5>PAYMENT METHOD</h5>
        <p class="payment-method">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
          <%= order.paymentInfo.method %>
        </p>
      </div>

      <div class="detail-block">
        <h5>TOTAL AMOUNT DUE</h5>
        <p style="font-weight: 600; font-size: 1.1rem; margin-top: 5px;">₹<%= order.pricing.totalAmount.toFixed(2) %></p>
      </div>

    </div>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>
