<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | <%= title %></title>
  
  <!-- Preload Fonts and External CSS to prevent FOUC -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/user/home-navbar.css" />
  <link rel="stylesheet" href="/css/user/footer.css" />
  <link rel="stylesheet" href="/css/admin/modal.css" />
  <link rel="stylesheet" href="/css/user/wallet.css" />

  <% 
    locals._homeNavbarCssLoaded = true;
    locals._footerCssLoaded = true;
  %>
</head>

<body style="background-color: #fcfbf8;">
  <%- include('../partials/home-navbar') %>

    <div class="wallet-wrapper">
      <div class="wallet-header">
        <h1>My Wallet</h1>
        <p>Manage credits, refunds, rewards, and promotional balances.</p>
      </div>

      <!-- Main Balance Card -->
      <div class="balance-card">
        <div class="balance-info">
          <div class="label">AVAILABLE BALANCE</div>
          <div class="amount">₹<%= wallet.balance.toFixed(2) %>
          </div>
          <div class="balance-meta">
            <span><img src="/images/icons/user/calendar-days.svg" alt="Date"> Member since: <%= new
                Date(user.createdAt).toLocaleDateString('en-US', { month: 'long' , year: 'numeric' }) %></span>
            <span class="tier-badge">⭐ ELSH Ritual Member</span>
          </div>
        </div>
        <div class="balance-actions">
          <button class="btn-add-credit" onclick="showComingSoonModal('Add Credit')">ADD CREDIT</button>
          <button class="btn-redeem" onclick="showComingSoonModal('Redeem Gift Card')">REDEEM GIFT CARD</button>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="label">AVAILABLE CREDITS</div>
          <div class="amount">₹<%= wallet.balance.toFixed(2) %>
          </div>
          <div class="desc">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="opacity:0.6;">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            +₹0 from last month
          </div>
        </div>
        <div class="stat-card">
          <div class="label">REWARDS EARNED</div>
          <div class="amount">₹0.00</div>
          <div class="desc">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="opacity:0.6;">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 16 16 12 12 8"></polyline>
              <line x1="8" y1="12" x2="16" y2="12"></line>
            </svg>
            Eligible for next tier purchase
          </div>
        </div>
        <div class="stat-card">
          <div class="label">TOTAL REFUNDS RECEIVED</div>
          <div class="amount">₹<%= wallet.totalRefunds.toFixed(2) %>
          </div>
          <div class="desc">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              style="opacity:0.6;">
              <polyline points="1 4 1 10 7 10"></polyline>
              <polyline points="23 20 23 14 17 14"></polyline>
              <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
            </svg>
            <%= wallet.transactions.filter(t=> t.type === 'CREDIT').length %> refunds processed in total
          </div>
        </div>
      </div>

      <!-- Manage Coupons -->
      <a href="/coupons" class="manage-coupons-btn" style="text-decoration: none; display: block;">MANAGE COUPONS</a>

      <!-- Transactions Section -->
      <div class="transactions-section">
        <h2>Transaction History</h2>

        <% if (transactions.length> 0) { %>
          <div class="transaction-list">
            <% transactions.forEach(txn=> { %>
              <div class="transaction-item">
                <div class="txn-info">
                  <h4>
                    <%= txn.description %>
                  </h4>
                  <p>
                    <%= new Date(txn.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'short' ,
                      day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                  </p>
                </div>
                <div class="txn-amount <%= txn.type.toLowerCase() %>">
                  <%= txn.type==='CREDIT' ? '+' : '-' %>₹<%= txn.amount.toFixed(2) %>
                </div>
              </div>
              <% }) %>
          </div>

          <% if (totalPages> 1) { %>
            <div class="pagination">
              <% if (currentPage> 1) { %>
                <a href="/wallet?page=<%= currentPage - 1 %>" class="page-btn">Prev</a>
                <% } %>

                  <% for(let i=1; i <=totalPages; i++) { %>
                    <a href="/wallet?page=<%= i %>" class="page-btn <%= currentPage === i ? 'active' : '' %>">
                      <%= i %>
                    </a>
                    <% } %>

                      <% if (currentPage < totalPages) { %>
                        <a href="/wallet?page=<%= currentPage + 1 %>" class="page-btn">Next</a>
                        <% } %>
            </div>
            <% } %>
              <% } else { %>
                <p style="color: #888; font-size: 14px;">No transactions found.</p>
                <% } %>
      </div>

    </div>

    <%- include('../partials/footer') %>

      <script>
        function showComingSoonModal(featureName) {
          showCustomModal({
            title: 'Coming Soon',
            message: `The <strong>${featureName}</strong> feature is currently under development and will be available next week. Stay tuned!`,
            iconType: 'warning',
            confirmText: 'Got it',
            showCancel: false,
            onConfirm: () => closeCustomModal()
          });
        }
      </script>
</body>

</html>