<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | Page Not Found</title>
  <link rel="stylesheet" href="/css/user/shop.css" />
  <style>
    .not-found-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 70vh;
      text-align: center;
      padding: 40px 20px;
      font-family: 'Inter', sans-serif;
    }

    .not-found-title {
      font-family: 'Playfair Display', serif;
      font-size: 8rem;
      font-weight: 700;
      color: #222;
      margin: 0;
      line-height: 1;
    }

    .not-found-subtitle {
      font-size: 1.5rem;
      font-weight: 500;
      color: #555;
      margin-top: 10px;
      margin-bottom: 20px;
    }

    .not-found-text {
      color: #777;
      max-width: 500px;
      line-height: 1.6;
      margin-bottom: 40px;
    }

    .back-home-btn {
      display: inline-block;
      padding: 14px 32px;
      background-color: #222;
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      letter-spacing: 1px;
      border-radius: 4px;
      transition: background-color 0.3s ease, transform 0.2s ease;
    }

    .back-home-btn:hover {
      background-color: #444;
      transform: translateY(-2px);
    }
  </style>
</head>

<body>

  <%- include('./partials/home-navbar') %>

  <div class="not-found-container">
    <h1 class="not-found-title">404</h1>
    <h2 class="not-found-subtitle">Page Not Found</h2>
    <p class="not-found-text">
      We're sorry, but the page you were looking for doesn't exist. It might have been moved, deleted, or perhaps you mistyped the URL.
    </p>
    <a href="/" class="back-home-btn">BACK TO HOME</a>
  </div>

  <%- include('./partials/footer') %>

</body>

</html>
