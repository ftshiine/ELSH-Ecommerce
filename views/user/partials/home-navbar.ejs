<% if (!locals._homeNavbarCssLoaded) { %>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/user/home-navbar.css" />
  <% locals._homeNavbarCssLoaded=true; %>
    <% } %>
      <nav class="home-navbar">
        <div class="home-navbar-container">
          <a href="/home" class="home-navbar-logo">ELSH</a>

          <ul class="home-navbar-links">
            <li><a href="/shop">SHOP</a></li>
          </ul>

          <div class="home-navbar-actions">


            <!-- User Dropdown -->
            <div class="user-dropdown-wrapper">
              <button class="nav-icon-btn" id="userDropdownBtn">
                <img src="/images/icons/admin/customers.svg" alt="Profile" />
              </button>
              <div class="user-dropdown" id="userDropdown">
                <a href="/profile" class="dropdown-item">
                  <img src="/images/icons/admin/customers.svg" alt="Profile" />
                  My Profile
                </a>
                <a href="/profile/addresses" class="dropdown-item">
                  <img src="/images/icons/admin/globe.svg" alt="Ritual Sites" />
                  Ritual Sites
                </a>
                <a href="/orders" class="dropdown-item">
                  <img src="/images/icons/user/package.svg" alt="My Orders" />
                  My Orders
                </a>
                <a href="/wallet" class="dropdown-item">
                  <img src="/images/icons/admin/wallet-cards.svg" alt="My Wallet" />
                  My Wallet
                </a>
                <a href="/profile/coupons" class="dropdown-item">
                  <img src="/images/icons/admin/badge-percent.svg" alt="My Coupons" style="width: 18px; height: 18px; opacity: 0.7;" />
                  My Coupons
                </a>
                <a href="javascript:void(0)" onclick="handleLogout(event)" class="dropdown-item dropdown-logout">
                  <img src="/images/icons/admin/logout.svg" alt="Logout" />
                  Logout
                </a>
              </div>
            </div>

            <a href="/wishlist" class="nav-icon-btn badge-btn" title="Wishlist">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                style="color: #2c2c2c;">
                <path
                  d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
                </path>
              </svg>
              <% if (locals.wishlistCount && locals.wishlistCount> 0) { %>
                <span class="nav-badge wishlist-badge">
                  <%= locals.wishlistCount %>
                </span>
                <% } else { %>
                  <span class="nav-badge wishlist-badge" style="display: none;">0</span>
                  <% } %>
            </a>

            <a href="/cart" class="nav-icon-btn badge-btn">
              <img src="/images/icons/user/shopping-bag.svg" alt="Cart" />
              <% if (locals.cartCount && locals.cartCount> 0) { %>
                <span class="nav-badge cart-badge">
                  <%= locals.cartCount %>
                </span>
                <% } else { %>
                  <span class="nav-badge cart-badge" style="display: none;">0</span>
                  <% } %>
            </a>
          </div>
        </div>
      </nav>

      <script>
        const userDropdownBtn = document.getElementById('userDropdownBtn');
        const userDropdown = document.getElementById('userDropdown');

        userDropdownBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          userDropdown.classList.toggle('active');
        });

        document.addEventListener('click', () => {
          userDropdown.classList.remove('active');
        });

        // Bfcache (Back/Forward Cache) Busting
        // Forces the page to reload when navigating back, ensuring session state is fresh
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) {
            window.location.reload();
          }
        });
      </script>