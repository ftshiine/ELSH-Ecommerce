<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | <%= title %>
  </title>
  <link rel="stylesheet" href="/css/user/order-detail.css" />
</head>

<body>
  <%- include('../partials/home-navbar') %>
    <%- include('../partials/breadcrumbs') %>

      <% const datePlaced=new Date(order.createdAt).toLocaleDateString('en-US', { month: 'long' , day: 'numeric' ,
        year: 'numeric' }); let dateArriving=new Date(order.createdAt); dateArriving.setDate(dateArriving.getDate() +
        4); dateArriving=dateArriving.toLocaleDateString('en-US', { month: 'long' , day: 'numeric' }); // Compute timeline states
        let orderedActive=true; let processingActive=['PROCESSING', 'SHIPPED' , 'OUT FOR DELIVERY'
        , 'DELIVERED' ].includes(order.orderStatus); let shippedActive=['SHIPPED', 'OUT FOR DELIVERY' , 'DELIVERED'
        ].includes(order.orderStatus); let outForDeliveryActive=['OUT FOR DELIVERY', 'DELIVERED'
        ].includes(order.orderStatus); let arrivedActive=order.orderStatus==='DELIVERED' ; let
        cancelled=order.orderStatus==='CANCELLED' ; let isCancellable=['PENDING', 'PROCESSING'
        ].includes(order.orderStatus); let isReturnable=order.orderStatus==='DELIVERED' ; %>

        <div class="order-detail-wrapper">
          <div class="header-section">
            <div class="header-titles">
              <h1>Order Ritual <span>#<%= order.orderId %></span></h1>
              <p>Placed on <%= datePlaced %> &bull; <%= arrivedActive ? 'Delivered' : 'Arriving by ' + dateArriving %>
              </p>
            </div>
            <div class="header-actions">
              <button class="btn-solid" onclick="downloadInvoice('<%= order._id %>')">Download Invoice</button>
            </div>
          </div>

          <% if (!cancelled) { %>
            <div class="timeline-box">
              <div class="timeline-header">
                <h2>Ritual Preparation</h2>
                <span class="timeline-status-badge">&bull; Currently Infusing Ingredients</span>
              </div>
              <div class="timeline-container">
                <div class="timeline-step <%= orderedActive ? 'active' : '' %>">
                  <div class="step-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg></div>
                  <div class="step-text">ORDERED</div>
                  <div class="step-date">
                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short' , day: 'numeric' }) %>
                  </div>
                </div>
                <div class="timeline-line <%= processingActive ? 'active' : '' %>"></div>
                <div class="timeline-step <%= processingActive ? 'active' : '' %>">
                  <div class="step-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg></div>
                  <div class="step-text">PROCESSING</div>
                  <div class="step-date">In Formulation</div>
                </div>
                <div class="timeline-line <%= shippedActive ? 'active' : '' %>"></div>
                <div class="timeline-step <%= shippedActive ? 'active' : '' %>">
                  <div class="step-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <rect x="1" y="3" width="15" height="13"></rect>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                      <circle cx="5.5" cy="18.5" r="2.5"></circle>
                      <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg></div>
                  <div class="step-text">SHIPPED</div>
                  <div class="step-date">In Transit</div>
                </div>
                <div class="timeline-line <%= outForDeliveryActive ? 'active' : '' %>"></div>
                <div class="timeline-step <%= outForDeliveryActive ? 'active' : '' %>">
                  <div class="step-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M5 12h14"></path>
                      <path d="M12 5l7 7-7 7"></path>
                    </svg></div>
                  <div class="step-text">OUT FOR DELIVERY</div>
                  <div class="step-date">Arriving Today</div>
                </div>
                <div class="timeline-line <%= arrivedActive ? 'active' : '' %>"></div>
                <div class="timeline-step <%= arrivedActive ? 'active' : '' %>">
                  <div class="step-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path
                        d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                      </path>
                    </svg></div>
                  <div class="step-text">ARRIVED</div>
                  <div class="step-date">Estimated</div>
                </div>
              </div>
            </div>
            <% } else { %>
              <div class="timeline-box cancelled-box">
                <div class="timeline-header">
                  <h2>Order Cancelled</h2>
                  <span class="timeline-status-badge badge-cancelled">&bull; Ritual Cancelled</span>
                </div>
                <p>This order has been cancelled. No further processing will occur.</p>
              </div>
              <% } %>

                <div class="main-grid">
                  <div class="grid-left">
                    <!-- Items Box -->
                    <div class="info-box items-box">
                      <h3>ITEMS IN YOUR RITUAL</h3>
                      <% order.items.forEach(item=> { %>
                        <div class="item-row">
                          <div class="item-img">
                            <% if (item.thumbnail) { %>
                              <img src="<%= item.thumbnail %>" alt="<%= item.productName %>">
                              <% } else { %>
                                <div class="no-img"></div>
                                <% } %>
                          </div>
                          <div class="item-info">
                            <div class="item-header">
                              <h4 class="item-title">
                                <%= item.productName %>
                              </h4>
                              <span class="item-price">₹<%= item.price.toFixed(2) %></span>
                            </div>
                            <p class="item-desc">
                              <%= item.variantName %> &bull; Concentrated plant-based bioactive repair serum
                            </p>
                            <div class="item-tags">
                              <span class="item-tag">Sustainable Packaging</span>
                              <span class="item-tag">Lab Verified</span>
                            </div>

                            <div
                              style="margin-top: 15px; display: flex; justify-content: space-between; align-items: center;">
                              <% let itemReturnable=false; let itemReturnMsg="" ; if (order.orderStatus==='DELIVERED' &&
                                item.itemStatus !=='CANCELLED' && item.itemStatus !=='RETURNED' && item.itemStatus
                                !=='RETURN_REQUESTED' ) { if (item.returnWindowDays===0) {
                                itemReturnMsg="Non-returnable item" ; } else if (order.deliveredAt) { const
                                deliveredDate=new Date(order.deliveredAt); const expiryDate=new
                                Date(deliveredDate.getTime() + item.returnWindowDays * 24 * 60 * 60 * 1000); if (new
                                Date() <=expiryDate) { itemReturnable=true; } else {
                                itemReturnMsg="Return window expired" ; } } else { itemReturnable=true; } } %>
                                <% if (item.itemStatus==='CANCELLED' ) { %>
                                  <span
                                    style="color: #d32f2f; font-weight: 600; font-size: 0.85rem; padding: 4px 8px; background: #ffebee; border-radius: 4px;">CANCELLED</span>
                                  <% } else if (item.itemStatus==='RETURNED' || item.itemStatus==='RETURN_REQUESTED' ) {
                                    %>
                                    <span
                                      style="color: #2196F3; font-weight: 600; font-size: 0.85rem; padding: 4px 8px; background: #e3f2fd; border-radius: 4px;">
                                      <%= item.itemStatus.replace('_', ' ' ) %>
                                    </span>
                                    <% } else if (isCancellable) { %>
                                      <button onclick="cancelSpecificItem('<%= order._id %>', '<%= item._id %>')"
                                        style="background: none; border: 1px solid #d32f2f; color: #d32f2f; padding: 6px 12px; font-size: 0.8rem; cursor: pointer; border-radius: 4px; transition: all 0.2s;">
                                        Cancel Item
                                      </button>
                                      <% } else if (itemReturnable) { %>
                                        <button onclick="returnSpecificItem('<%= order._id %>', '<%= item._id %>')"
                                          style="background: none; border: 1px solid #222; color: #222; padding: 6px 12px; font-size: 0.8rem; cursor: pointer; border-radius: 4px; transition: all 0.2s;">
                                          Return Item
                                        </button>
                                        <% } else if (itemReturnMsg) { %>
                                          <span style="color: #f57c00; font-size: 0.8rem;">
                                            <%= itemReturnMsg %>
                                          </span>
                                          <% } else { %>
                                            <span
                                              style="color: #4CAF50; font-weight: 600; font-size: 0.85rem; padding: 4px 8px; background: #e8f5e9; border-radius: 4px;">
                                              <%= item.itemStatus || order.orderStatus %>
                                            </span>
                                            <% } %>
                            </div>

                          </div>
                        </div>
                        <% }) %>
                    </div>

                    <div class="bottom-split">
                      <!-- Destination -->
                      <div class="info-box">
                        <h3><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                          </svg> DESTINATION</h3>
                        <p class="address-text">
                          <strong>
                            <%= order.shippingAddress.fullName %>
                          </strong><br>
                          <%= order.shippingAddress.addressLine1 %><br>
                            <% if(order.shippingAddress.addressLine2) { %>
                              <%= order.shippingAddress.addressLine2 %><br>
                                <% } %>
                                  <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %>
                                      <%= order.shippingAddress.postalCode %><br>
                                        <%= order.shippingAddress.country %>
                        </p>
                        <h4 class="sub-h4">METHOD</h4>
                        <p class="address-text">Climate-Neutral Ground (3-5 Days)</p>
                      </div>

                      <!-- Payment -->
                      <div class="info-box">
                        <h3><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                          </svg> PAYMENT</h3>
                        <div class="payment-card-badge">
                          <span class="card-icon"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                              <line x1="1" y1="10" x2="23" y2="10"></line>
                            </svg></span>
                          <div class="card-text">
                            <strong>
                              <%= order.paymentInfo.method==='COD' ? 'Cash on Delivery' : order.paymentInfo.method %>
                            </strong>
                            <span>Billing same as shipping</span>
                          </div>
                        </div>
                        <% if (order.paymentInfo.transactionId) { %>
                          <h4 class="sub-h4">TRANSACTION ID</h4>
                          <p class="address-text">#<%= order.paymentInfo.transactionId %>
                          </p>
                          <% } %>
                      </div>
                    </div>
                  </div>

                  <div class="grid-right">
                    <!-- Invoice Summary -->
                    <div class="info-box invoice-box">
                      <h3>INVOICE SUMMARY</h3>
                      <div class="invoice-row">
                        <span>Subtotal</span>
                        <span>₹<%= order.pricing.subtotal.toFixed(2) %></span>
                      </div>
                      <div class="invoice-row">
                        <span>Shipping</span>
                        <span>
                          <%= order.pricing.shippingFee> 0 ? '₹' + order.pricing.shippingFee.toFixed(2) :
                            'COMPLIMENTARY' %>
                        </span>
                      </div>
                      <div class="invoice-row">
                        <span>Estimated Taxes</span>
                        <span>₹<%= (order.pricing.totalAmount - order.pricing.subtotal - order.pricing.shippingFee +
                            order.pricing.discount).toFixed(2) %></span>
                      </div>
                      <% if (order.pricing.discount> 0) { %>
                        <div class="invoice-row" style="color: #219653;">
                          <span>Discount (<%= order.pricing.couponCode || 'Promo' %>)</span>
                          <span>-₹<%= order.pricing.discount.toFixed(2) %></span>
                        </div>
                        <% } %>
                          <hr class="invoice-divider">
                          <div class="invoice-total">
                            <span>TOTAL AMOUNT</span>
                            <span class="total-price">₹<%= order.pricing.totalAmount.toFixed(2) %></span>
                          </div>
                          <p class="invoice-footer">Secure transaction processed via ELSH Encrypted Gateways.</p>
                    </div>

                    <!-- Action Card (Cancel/Return) -->
                    <div class="action-card">
                      <div class="action-message">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                          stroke="#a08560" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="12" y1="8" x2="12" y2="12"></line>
                          <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <p>
                          <% if (isCancellable) { %>
                            Your order is currently in the formulation phase. You may cancel your order until it is
                            assigned a tracking number.
                            <% } else if (order.orderStatus==='DELIVERED' ) { %>
                              Your order has been delivered. You can request item-level returns for eligible products
                              above.
                              <% } else { %>
                                Your order is being processed or has already shipped. If you have any issues, please
                                contact the concierge.
                                <% } %>
                        </p>
                      </div>

                      <% if (order.paymentInfo.method==='Razorpay' && order.paymentInfo.status==='PENDING' &&
                        order.orderStatus !=='CANCELLED' ) { %>
                        <button class="btn-solid" onclick="retryPayment('<%= order._id %>')"
                          style="background-color: #556b55; color: white; width: 100%; margin-bottom: 12px; padding: 12px; border: none; font-weight: 600; cursor: pointer; border-radius: 4px;">
                          COMPLETE PAYMENT
                        </button>
                        <% } %>

                          <% if (isCancellable) { %>
                            <button class="btn-cancel" onclick="cancelOrder('<%= order._id %>')">
                              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round" style="margin-right: 6px;">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                              </svg>
                              CANCEL ENTIRE ORDER
                            </button>
                            <% } %>

                              <a href="/contact" class="btn-contact">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                  stroke-linejoin="round" style="margin-right: 6px;">
                                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                  <line x1="16" y1="2" x2="16" y2="6"></line>
                                  <line x1="8" y1="2" x2="8" y2="6"></line>
                                  <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                CONTACT CONCIERGE
                              </a>
                    </div>
                  </div>
                </div>
        </div>

        <%- include('../partials/footer') %>

          <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
          <script>
            async function retryPayment(orderId) {
              try {
                const response = await fetch(`/orders/${orderId}/retry-payment`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (!data.success) {
                  showCustomModal({
                    title: 'Error',
                    message: data.message || 'Failed to initiate payment.',
                    iconType: 'warning',
                    confirmText: 'OK',
                    showCancel: false
                  });
                  return;
                }

                const options = {
                  key: data.key,
                  amount: data.amount,
                  currency: 'INR',
                  name: 'ELSH',
                  description: 'Order Payment Retry',
                  order_id: data.razorpayOrderId,
                  handler: async function (response) {
                    try {
                      const verifyRes = await fetch('/checkout/verify-payment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                          razorpay_payment_id: response.razorpay_payment_id,
                          razorpay_order_id: response.razorpay_order_id,
                          razorpay_signature: response.razorpay_signature,
                          orderId: data.orderId
                        })
                      });

                      const verifyData = await verifyRes.json();
                      if (verifyData.success) {
                        showCustomModal({
                          title: 'Success',
                          message: 'Payment completed successfully!',
                          iconType: 'success',
                          confirmText: 'OK',
                          showCancel: false,
                          onConfirm: () => window.location.reload()
                        });
                      } else {
                        if (verifyData.oversold) {
                          showCustomModal({
                            title: 'Out of Stock',
                            message: verifyData.message,
                            iconType: 'warning',
                            confirmText: 'OK',
                            showCancel: false,
                            onConfirm: () => window.location.reload()
                          });
                        } else {
                          window.location.href = '/checkout/failure/' + data.orderId;
                        }
                      }
                    } catch (err) {
                      window.location.href = '/checkout/failure/' + data.orderId;
                    }
                  },
                  theme: { color: '#556b55' },
                  modal: {
                    ondismiss: function () {
                      window.location.href = '/checkout/failure/' + data.orderId;
                    }
                  }
                };

                const rzp = new Razorpay(options);
                rzp.on('payment.failed', function (response) {
                  window.location.href = '/checkout/failure/' + data.orderId;
                });
                rzp.open();
              } catch (error) {
                showCustomModal({
                  title: 'Error',
                  message: 'Something went wrong while starting payment',
                  iconType: 'warning',
                  confirmText: 'OK',
                  showCancel: false
                });
              }
            }

            function cancelOrder(orderId) {
              showCustomModal({
                title: 'Cancel Order?',
                message: 'Are you sure you want to cancel this order?',
                iconType: 'warning',
                confirmText: 'Yes, Cancel',
                showCancel: true,
                showInput: true,
                requireInput: true,
                inputPlaceholder: 'Please tell us why you want to cancel',
                onConfirm: async (reason) => {
                  try {
                    const response = await fetch(`/orders/${orderId}/cancel`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ reason })
                    });
                    const data = await response.json();
                    if (data.success) {
                      showCustomModal({
                        title: 'Cancelled!',
                        message: 'Your order has been cancelled.',
                        iconType: 'success',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => window.location.reload()
                      });
                    } else {
                      showCustomModal({
                        title: 'Error',
                        message: data.message,
                        iconType: 'warning',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => closeCustomModal()
                      });
                    }
                  } catch (error) {
                    showCustomModal({
                      title: 'Error',
                      message: 'Failed to cancel the order. Please try again.',
                      iconType: 'warning',
                      confirmText: 'OK',
                      showCancel: false,
                      onConfirm: () => closeCustomModal()
                    });
                  }
                }
              });
            }

            function cancelSpecificItem(orderId, itemId) {
              showCustomModal({
                title: 'Cancel Item?',
                message: 'Are you sure you want to cancel this specific item? The rest of your order will remain unchanged.',
                iconType: 'warning',
                confirmText: 'Yes, Cancel Item',
                showCancel: true,
                showInput: true,
                requireInput: true,
                inputPlaceholder: 'Please tell us why you want to cancel',
                onConfirm: async (reason) => {
                  try {
                    const response = await fetch(`/orders/${orderId}/cancel-item/${itemId}`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ reason })
                    });
                    const data = await response.json();
                    if (data.success) {
                      showCustomModal({
                        title: 'Item Cancelled!',
                        message: 'Your item has been successfully cancelled.',
                        iconType: 'success',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => window.location.reload()
                      });
                    } else {
                      showCustomModal({
                        title: 'Error',
                        message: data.message,
                        iconType: 'warning',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => closeCustomModal()
                      });
                    }
                  } catch (error) {
                    showCustomModal({
                      title: 'Error',
                      message: 'Something went wrong',
                      iconType: 'warning',
                      confirmText: 'OK',
                      showCancel: false,
                      onConfirm: () => closeCustomModal()
                    });
                  }
                }
              });
            }

            async function returnOrder(orderId) {
              showCustomModal({
                title: 'Return Order',
                message: 'Are you sure you want to return this entire order? Please provide a reason below:',
                iconType: 'warning',
                confirmText: 'Submit Return',
                showCancel: true,
                showInput: true,
                inputPlaceholder: 'Please tell us why you are returning this item...',
                requireInput: true,
                onConfirm: async (reason) => {
                  if (!reason) return;
                  try {
                    const response = await fetch(`/orders/${orderId}/return`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ reason })
                    });
                    const data = await response.json();
                    if (data.success) {
                      showCustomModal({
                        title: 'Return Requested',
                        message: 'Your return request has been submitted successfully.',
                        iconType: 'success',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => window.location.reload()
                      });
                    } else {
                      showCustomModal({
                        title: 'Request Failed',
                        message: data.message || 'Error initiating return',
                        iconType: 'warning',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => closeCustomModal()
                      });
                    }
                  } catch (error) {
                    showCustomModal({
                      title: 'Error',
                      message: 'Something went wrong',
                      iconType: 'warning',
                      confirmText: 'OK',
                      showCancel: false,
                      onConfirm: () => closeCustomModal()
                    });
                  }
                }
              });
            }

            function returnSpecificItem(orderId, itemId) {
              showCustomModal({
                title: 'Return Item',
                message: 'Are you sure you want to return this item? Please provide a reason below:',
                iconType: 'warning',
                confirmText: 'Submit Return',
                showCancel: true,
                showInput: true,
                requireInput: true,
                inputPlaceholder: 'Please tell us why you are returning this item (e.g. Damaged, Defective, Not as described)...',
                onConfirm: async (reason) => {
                  try {
                    const response = await fetch(`/orders/${orderId}/return-item/${itemId}`, {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json'
                      },
                      body: JSON.stringify({ reason })
                    });

                    const data = await response.json();
                    if (data.success) {
                      showCustomModal({
                        title: 'Return Requested',
                        message: data.message || 'Your return request for this item has been submitted.',
                        iconType: 'success',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => window.location.reload()
                      });
                    } else {
                      showCustomModal({
                        title: 'Return Failed',
                        message: data.message || 'Failed to submit return request',
                        iconType: 'warning',
                        confirmText: 'OK',
                        showCancel: false,
                        onConfirm: () => closeCustomModal()
                      });
                    }
                  } catch (error) {
                    showCustomModal({
                      title: 'Error',
                      message: 'An error occurred. Please try again.',
                      iconType: 'warning',
                      confirmText: 'OK',
                      showCancel: false,
                      onConfirm: () => closeCustomModal()
                    });
                  }
                }
              });
            }

            async function downloadInvoice(orderId) {
              // Trigger the download in a new tab
              window.open(`/orders/${orderId}/invoice`, '_blank');

              // Show success modal
              showCustomModal({
                title: 'Download Started',
                message: 'Your invoice has been downloaded successfully.',
                iconType: 'success',
                confirmText: 'Close',
                showCancel: false,
                onConfirm: () => closeCustomModal()
              });
            }
          </script>
</body>

</html>