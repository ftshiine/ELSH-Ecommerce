<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | <%= locals.address ? 'Edit' : 'New' %> Ritual Site</title>
  <link rel="stylesheet" href="/css/user/address.css" />
</head>

<body>

  <%- include('../../partials/home-navbar') %>
  <%- include('../../partials/breadcrumbs') %>

    <div class="address-wrapper">

      <div class="page-header">
        <h1>
          <%= locals.address ? 'Edit' : 'New' %> Ritual Site
        </h1>
        <p>Specify the sanctuary where your ELSH essentials should arrive.<br>We ensure every delivery is handled with
          intentional care.</p>
      </div>

      <% if (locals.error) { %>
        <div class="alert-error">
          <%= locals.error %>
        </div>
        <% } %>

          <div class="form-card">
            <% const actionUrl = locals.address ? `/profile/addresses/${locals.address._id}?_method=PUT` : '/profile/addresses/add'; %>
            <% const returnUrl = locals.returnTo ? (actionUrl.includes('?') ? `&returnTo=${locals.returnTo}` : `?returnTo=${locals.returnTo}`) : ''; %>
            <form action="<%= actionUrl %><%= returnUrl %>" method="POST" id="addressForm">

              <div class="form-row">
                <div class="form-group">
                  <label>FULL NAME</label>
                  <div class="input-wrapper <%= locals.fieldErrors?.fullName ? 'has-error' : '' %>">
                    <input type="text" name="fullName" placeholder="Julianne Moore"
                      value="<%= locals.formData?.fullName || locals.address?.fullName || '' %>">
                  </div>
                  <% if (locals.fieldErrors?.fullName) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.fullName ? locals.fieldErrors.fullName : '' %>
                    </div>
                    <% } %>
                </div>

                <div class="form-group">
                  <label>PHONE NUMBER</label>
                  <div class="input-wrapper <%= locals.fieldErrors?.phone ? 'has-error' : '' %>">
                    <input type="text" name="phone" placeholder="+1 (555) 000-0000"
                      value="<%= locals.formData?.phone || locals.address?.phone || '' %>">
                  </div>
                  <% if (locals.fieldErrors?.phone) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.phone ? locals.fieldErrors.phone : '' %>
                    </div>
                    <% } %>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group full-width">
                  <label>ADDRESS LINE 1</label>
                  <div class="input-wrapper <%= locals.fieldErrors?.addressLine1 ? 'has-error' : '' %>">
                    <input type="text" name="addressLine1" placeholder="Apartment, suite, unit, or building"
                      value="<%= locals.formData?.addressLine1 || locals.address?.addressLine1 || '' %>">
                  </div>
                  <% if (locals.fieldErrors?.addressLine1) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.addressLine1 ? locals.fieldErrors.addressLine1 : '' %>
                    </div>
                    <% } %>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group full-width">
                  <label>LANDMARK (OPTIONAL)</label>
                  <div class="input-wrapper <%= locals.fieldErrors?.landmark ? 'has-error' : '' %>">
                    <input type="text" name="landmark" placeholder="Near the botanical conservatory"
                      value="<%= locals.formData?.landmark || locals.address?.landmark || '' %>">
                  </div>
                  <% if (locals.fieldErrors?.landmark) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.landmark ? locals.fieldErrors.landmark : '' %>
                    </div>
                    <% } %>
                </div>
              </div>

              <div class="form-row" style="grid-template-columns: 1fr 1fr; gap: 24px;">
                <div class="form-group">
                  <label>COUNTRY</label>
                  <% const selectedCountry=locals.formData?.country || locals.address?.country || 'India' ; %>
                  <div class="input-wrapper custom-dropdown-wrapper" style="position: relative; border-bottom: none; padding: 0;">
                    <div class="custom-dropdown form-control" id="countryDropdown" style="padding: 0; border: none; background: transparent; width: 100%;">
                      <div class="dropdown-selected" onclick="toggleDropdown(event, 'countryOptions')" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; padding: 8px 0 12px; border-bottom: 1px solid #e0e0d8; width: 100%;">
                        <span id="selectedCountryText"><%= selectedCountry %></span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </div>
                      <div class="dropdown-options" id="countryOptions" style="display: none; position: absolute; top: 100%; left: 0; width: 100%; background: white; border: 1px solid #e0e0d8; z-index: 10; max-height: 200px; overflow-y: auto;">
                        <div class="dropdown-option <%= selectedCountry==='India' ? 'active' : '' %>" onclick="selectCountry('India', 'India')">India</div>
                      </div>
                    </div>
                    <input type="hidden" name="country" id="countryInput" value="<%= selectedCountry %>">
                  </div>
                  <% if (locals.fieldErrors?.country) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.country ? locals.fieldErrors.country : '' %>
                    </div>
                  <% } %>
                </div>

                <div class="form-group">
                  <label>STATE</label>
                  <% const selectedState=locals.formData?.state || locals.address?.state || '' ; %>
                  <div class="input-wrapper custom-dropdown-wrapper" style="position: relative; border-bottom: none; padding: 0;">
                    <div class="custom-dropdown form-control" id="stateDropdown" style="padding: 0; border: none; background: transparent; width: 100%;">
                      <div class="dropdown-selected" onclick="toggleDropdown(event, 'stateOptions')" style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; padding: 8px 0 12px; border-bottom: 1px solid #e0e0d8; width: 100%;">
                        <% if (selectedState) { %>
                        <span id="selectedStateText" style="color: #333;"><%= selectedState %></span>
                        <% } else { %>
                        <span id="selectedStateText" style="color: #ccc;">Select State</span>
                        <% } %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </div>
                      <div class="dropdown-options" id="stateOptions" style="display: none; position: absolute; top: 100%; left: 0; width: 100%; background: white; border: 1px solid #e0e0d8; z-index: 10; max-height: 200px; overflow-y: auto;">
                        <div class="dropdown-option <%= !selectedState ? 'active' : '' %>" onclick="selectState('', 'Select State')">Select State</div>
                        <% var indiaStatesList=[ 'Andhra Pradesh' , 'Arunachal Pradesh' , 'Assam' , 'Bihar', 'Chhattisgarh' , 'Goa' , 'Gujarat' , 'Haryana' , 'Himachal Pradesh' , 'Jharkhand', 'Karnataka' , 'Kerala' , 'Madhya Pradesh' , 'Maharashtra' , 'Manipur' , 'Meghalaya', 'Mizoram' , 'Nagaland' , 'Odisha' , 'Punjab' , 'Rajasthan' , 'Sikkim' , 'Tamil Nadu', 'Telangana' , 'Tripura' , 'Uttar Pradesh' , 'Uttarakhand' , 'West Bengal', 'Andaman and Nicobar Islands' , 'Chandigarh' , 'Dadra and Nagar Haveli and Daman and Diu', 'Delhi' , 'Jammu and Kashmir' , 'Ladakh' , 'Lakshadweep' , 'Puducherry' ];
                        indiaStatesList.forEach(s=> { %>
                          <div class="dropdown-option <%= selectedState===s ? 'active' : '' %>" onclick="selectState('<%= s %>', '<%= s %>')"><%= s %></div>
                        <% }); %>
                      </div>
                    </div>
                    <input type="hidden" name="state" id="stateInput" value="<%= selectedState %>">
                  </div>
                  <% if (locals.fieldErrors?.state) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.state ? locals.fieldErrors.state : '' %>
                    </div>
                  <% } %>
                </div>
              </div>

              <div class="form-row" style="grid-template-columns: 1fr 1fr; gap: 24px;">
                <div class="form-group">
                  <label>CITY</label>
                  <div class="input-wrapper <%= locals.fieldErrors?.city ? 'has-error' : '' %>">
                    <input type="text" name="city" placeholder="Mumbai"
                      value="<%= locals.formData?.city || locals.address?.city || '' %>">
                  </div>
                  <% if (locals.fieldErrors?.city) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.city ? locals.fieldErrors.city : '' %>
                    </div>
                    <% } %>
                </div>
                <div class="form-group">
                  <label>PINCODE</label>
                  <div class="input-wrapper <%= locals.fieldErrors?.pincode ? 'has-error' : '' %>">
                    <input type="text" name="pincode" placeholder="400001"
                      value="<%= locals.formData?.pincode || locals.address?.pincode || '' %>">
                  </div>
                  <% if (locals.fieldErrors?.pincode) { %>
                    <div class="field-error">
                      <%= locals.fieldErrors?.pincode ? locals.fieldErrors.pincode : '' %>
                    </div>
                    <% } %>
                </div>
              </div>

              <% if (locals.address) { %>
                <div class="toggle-row">
                  <div class="toggle-info">
                    <h4>Set as Primary Ritual Site</h4>
                    <p>All future deliveries will default to this sanctuary.</p>
                  </div>
                  <label class="switch">
                    <% const isPrimaryChecked=locals.formData ? (locals.formData.isPrimary==='on' ) :
                      (locals.address?.isPrimary || false); %>
                      <input type="checkbox" name="isPrimary" <%=isPrimaryChecked ? 'checked' : '' %>>
                      <span class="slider"></span>
                  </label>
                </div>
                <% } %>

                  <div class="form-actions">
                    <button type="submit" class="btn-save">SAVE LOCATION</button>
                    <a href="/profile/addresses" class="btn-cancel">CANCEL</a>
                  </div>

            </form>
          </div>

    </div>

    <%- include('../../partials/footer') %>

      <script>
        // Custom Dropdown Logic
        function toggleDropdown(event, optionsId) {
          event.stopPropagation();
          const optionsDiv = document.getElementById(optionsId);
          const isCurrentlyVisible = optionsDiv.style.display === 'block';

          // Close all dropdowns
          document.querySelectorAll('.dropdown-options').forEach(el => {
            el.style.display = 'none';
          });

          // Toggle the clicked one
          if (!isCurrentlyVisible) {
            optionsDiv.style.display = 'block';
          }
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', () => {
          document.querySelectorAll('.dropdown-options').forEach(el => {
            el.style.display = 'none';
          });
        });

        function selectCountry(value, text) {
          document.getElementById('countryInput').value = value;
          document.getElementById('selectedCountryText').textContent = text;
          document.getElementById('selectedCountryText').style.color = '#333';
          
          // Update active class
          const options = document.getElementById('countryOptions').querySelectorAll('.dropdown-option');
          options.forEach(opt => opt.classList.remove('active'));
          event.target.classList.add('active');
        }

        function selectState(value, text) {
          document.getElementById('stateInput').value = value;
          document.getElementById('selectedStateText').textContent = text;
          document.getElementById('selectedStateText').style.color = value ? '#333' : '#ccc';

          // Update active class
          const options = document.getElementById('stateOptions').querySelectorAll('.dropdown-option');
          options.forEach(opt => opt.classList.remove('active'));
          event.target.classList.add('active');
        }
      </script>
      <script src="/js/validation.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          if (window.ELSHValidator) {
            window.ELSHValidator.attachToForm('addressForm', ['fullName', 'phone', 'addressLine1', 'landmark', 'country', 'state', 'city', 'pincode']);
          }
        });
      </script>
</body>

</html>