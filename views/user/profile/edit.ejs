<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | Edit Profile</title>
  <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body>

  <%- include('../partials/home-navbar') %>
  <%- include('../partials/breadcrumbs') %>

    <div class="profile-wrapper">

      <div class="edit-card">

        <div class="edit-card-header">
          <h2>Manage Profile</h2>
          <p>Update your personal information and account details.</p>
        </div>

        <div class="edit-divider"></div>

        <% if (locals.error) { %>
          <div class="auth-error">
            <%= locals.error %>
          </div>
          <% } %>
            <% if (locals.success) { %>
              <div class="auth-success">
                <%= locals.success %>
              </div>
              <% } %>

                <form id="removePhotoForm" action="/profile/photo?_method=DELETE" method="POST" style="display:none;"></form>
                <form id="changeEmailForm" action="/profile/email/initiate" method="POST" style="display:none;"></form>
                <form id="editProfileForm" action="/profile?_method=PUT" method="POST" enctype="multipart/form-data">

                  <div class="edit-section">
                    <label class="section-label">PROFILE PHOTO</label>
                    <div class="photo-upload-row">
                      <div class="edit-avatar">
                        <% if (user.profileImage) { %>
                          <img src="<%= user.profileImage %>" alt="Profile" id="avatarPreview" />
                          <% } else { %>
                            <div class="avatar-placeholder" id="avatarPlaceholder">
                              <%= user.fullName.charAt(0).toUpperCase() %>
                            </div>
                            <img src="" alt="Profile" id="avatarPreview" style="display:none;" />
                            <% } %>
                      </div>
                      <div class="photo-actions">
                        <label for="profileImage" class="btn-upload">UPLOAD NEW PHOTO</label>
                        <% if (user.profileImage) { %>
                          <button type="submit" form="removePhotoForm" class="btn-remove-photo">Remove Photo</button>
                          <% } %>

                      </div>
                    </div>
                    <div id="imageUploadError" class="field-error" style="display:none; margin-top: 0.5rem;"></div>
                  </div>

                  <div class="edit-divider"></div>

                  <div class="edit-section">
                    <label class="section-label">PERSONAL INFORMATION</label>

                    <div class="edit-form-row">
                      <div class="form-group">
                        <label>Full Name</label>
                        <div class="input-wrapper <%= locals.fieldErrors?.fullName ? 'has-error' : '' %>">
                          <input type="text" name="fullName"
                            value="<%= locals.formData?.fullName || user.fullName || '' %>" placeholder="Your full name"
                            required />
                        </div>
                        <% if (locals.fieldErrors?.fullName) { %>
                          <div class="field-error">
                            <%= locals.fieldErrors.fullName %>
                          </div>
                          <% } %>
                      </div>
                      <div class="form-group">
                        <label>Phone</label>
                        <div class="input-wrapper <%= locals.fieldErrors?.phone ? 'has-error' : '' %>">
                          <input type="tel" name="phone" value="<%= locals.formData?.phone || user.phone || '' %>"
                            placeholder="+1 (555) 000-0000" />
                        </div>
                        <% if (locals.fieldErrors?.phone) { %>
                          <div class="field-error">
                            <%= locals.fieldErrors.phone %>
                          </div>
                          <% } %>
                      </div>
                    </div>

                    <div class="edit-form-row">
                      <% if (user.googleId) { %>
                        <div class="form-group">
                          <label>Account Authentication</label>
                          <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.5rem; line-height: 1.4;">
                            This account was created using Google Sign-In.<br>
                            Your email address and password are managed by your Google account and cannot be changed
                            from ELSH.
                          </div>
                          <div class="input-wrapper"
                            style="background-color: #f5f5f5; border: 1px solid #ddd; padding: 0.8rem 1rem; border-radius: 4px; display: flex; align-items: center;">
                            <span style="color: #666; font-size: 0.9rem; flex-grow: 1;">[<%= user.email %>]</span>
                          </div>
                          <input type="hidden" name="email" value="<%= user.email %>" id="emailInput"
                            data-original="<%= user.email %>" />
                        </div>
                        <% } else { %>
                          <div class="form-group">
                            <label>Email Address</label>
                            <div style="display: flex; gap: 1rem; align-items: center;">
                              <div class="input-wrapper"
                                style="background-color: #f5f5f5; border: 1px solid #ddd; padding: 0.8rem 1rem; border-radius: 4px; flex-grow: 1;">
                                <span style="color: #666; font-size: 0.9rem;">
                                  <%= user.email %>
                                </span>
                              </div>
                              <button type="submit" form="changeEmailForm" class="btn-cancel"
                                style="border-color: #556B5B; color: #556B5B; background: transparent; cursor: pointer; padding: 0.8rem 1.5rem; text-transform: uppercase; font-size: 0.8rem; font-weight: 500; transition: all 0.3s ease; white-space: nowrap; height: auto;">CHANGE</button>
                            </div>
                          </div>
                          <% } %>
                            <div class="form-group">
                              <label>Gender</label>
                              <% const selectedGender=locals.formData?.gender || user.gender || '' %>
                                <div class="custom-dropdown-wrapper" id="genderDropdownWrapper">
                                  <input type="hidden" name="gender" id="genderInput" value="<%= selectedGender %>" />
                                  <div class="custom-dropdown-trigger" onclick="toggleProfileDropdown(event, 'genderDropdownOptions')">
                                    <span id="genderSelectedText"><%= selectedGender || 'Select Gender' %></span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                      <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                  </div>
                                  <div class="custom-dropdown-options" id="genderDropdownOptions">
                                    <div class="custom-dropdown-option <%= selectedGender === 'Male' ? 'active' : '' %>" onclick="selectGender('Male')">Male</div>
                                    <div class="custom-dropdown-option <%= selectedGender === 'Female' ? 'active' : '' %>" onclick="selectGender('Female')">Female</div>
                                    <div class="custom-dropdown-option <%= selectedGender === 'Other' ? 'active' : '' %>" onclick="selectGender('Other')">Other</div>
                                    <div class="custom-dropdown-option <%= selectedGender === 'Prefer not to say' ? 'active' : '' %>" onclick="selectGender('Prefer not to say')">Prefer not to say</div>
                                  </div>
                                </div>
                            </div>
                    </div>

                    <div class="edit-form-row">
                      <div class="form-group">
                        <label>Date of Birth</label>
                        <% const dobValue=locals.formData?.dateOfBirth || (user.dateOfBirth ? new
                          Date(user.dateOfBirth).toISOString().split('T')[0] : '' ) %>
                        <% 
                          let dobDay = '';
                          let dobMonth = '';
                          let dobYear = '';
                          if (dobValue) {
                            const parts = dobValue.split('-');
                            dobYear = parts[0];
                            dobMonth = parts[1];
                            dobDay = parts[2];
                          }
                        %>
                          <input type="hidden" name="dateOfBirth" id="dobHiddenInput" value="<%= dobValue %>" />
                          <div class="dob-picker-row">
                            <!-- Day -->
                            <div class="custom-dropdown-wrapper dob-field" id="dobDayWrapper">
                              <div class="custom-dropdown-trigger" onclick="toggleProfileDropdown(event, 'dobDayOptions')">
                                <span id="dobDayText"><%= dobDay || 'Day' %></span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                              </div>
                              <div class="custom-dropdown-options dob-dropdown-options" id="dobDayOptions">
                                <% for (let d = 1; d <= 31; d++) { %>
                                  <% const dStr = String(d).padStart(2, '0'); %>
                                  <div class="custom-dropdown-option <%= dobDay === dStr ? 'active' : '' %>" onclick="selectDob('day', '<%= dStr %>')"><%= d %></div>
                                <% } %>
                              </div>
                            </div>
                            <!-- Month -->
                            <div class="custom-dropdown-wrapper dob-field" id="dobMonthWrapper">
                              <div class="custom-dropdown-trigger" onclick="toggleProfileDropdown(event, 'dobMonthOptions')">
                                <span id="dobMonthText"><%= dobMonth ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][parseInt(dobMonth)-1] : 'Month' %></span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                              </div>
                              <div class="custom-dropdown-options dob-dropdown-options" id="dobMonthOptions">
                                <% const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December']; %>
                                <% for (let m = 1; m <= 12; m++) { %>
                                  <% const mStr = String(m).padStart(2, '0'); %>
                                  <div class="custom-dropdown-option <%= dobMonth === mStr ? 'active' : '' %>" onclick="selectDob('month', '<%= mStr %>')"><%= monthNames[m-1] %></div>
                                <% } %>
                              </div>
                            </div>
                            <!-- Year -->
                            <div class="custom-dropdown-wrapper dob-field" id="dobYearWrapper">
                              <div class="custom-dropdown-trigger" onclick="toggleProfileDropdown(event, 'dobYearOptions')">
                                <span id="dobYearText"><%= dobYear || 'Year' %></span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                              </div>
                              <div class="custom-dropdown-options dob-dropdown-options" id="dobYearOptions">
                                <% const currentYear = new Date().getFullYear(); %>
                                <% for (let y = currentYear; y >= currentYear - 100; y--) { %>
                                  <div class="custom-dropdown-option <%= dobYear === String(y) ? 'active' : '' %>" onclick="selectDob('year', '<%= y %>')"><%= y %></div>
                                <% } %>
                              </div>
                            </div>
                          </div>
                      </div>
                    </div>

                  </div>

                  <div class="edit-actions">
                    <a href="/profile" class="btn-cancel">CANCEL</a>
                    <button type="submit" class="btn-save">SAVE CHANGES</button>
                  </div>

                  <input type="file" id="profileImage" name="profileImage" accept="image/*" style="display:none;" />
                </form>
      </div>
    </div>

    <%- include('../partials/footer') %>

      <script>
        // ── Custom Dropdown Logic ──
        function toggleProfileDropdown(e, optionsId) {
          e.stopPropagation();
          // Close all other open dropdowns first
          document.querySelectorAll('.custom-dropdown-options').forEach(opt => {
            if (opt.id !== optionsId) opt.classList.remove('show');
          });
          const options = document.getElementById(optionsId);
          options.classList.toggle('show');

          // Scroll active item into view
          const activeItem = options.querySelector('.custom-dropdown-option.active');
          if (activeItem && options.classList.contains('show')) {
            setTimeout(() => activeItem.scrollIntoView({ block: 'nearest' }), 50);
          }
        }

        // Close dropdowns on outside click
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.custom-dropdown-wrapper')) {
            document.querySelectorAll('.custom-dropdown-options').forEach(opt => {
              opt.classList.remove('show');
            });
          }
        });

        // ── Gender Selection ──
        function selectGender(value) {
          document.getElementById('genderInput').value = value;
          document.getElementById('genderSelectedText').textContent = value;
          document.getElementById('genderDropdownOptions').classList.remove('show');

          // Update active state
          document.querySelectorAll('#genderDropdownOptions .custom-dropdown-option').forEach(opt => {
            opt.classList.remove('active');
            if (opt.textContent.trim() === value) opt.classList.add('active');
          });
        }

        // ── DOB Selection ──
        const dobState = {
          day: document.getElementById('dobDayText').textContent.trim(),
          month: document.getElementById('dobMonthText').textContent.trim(),
          year: document.getElementById('dobYearText').textContent.trim()
        };
        // Initialize from existing values
        if (dobState.day === 'Day') dobState.day = '';
        if (dobState.month === 'Month') dobState.month = '';
        if (dobState.year === 'Year') dobState.year = '';

        const monthShortNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        function selectDob(field, value) {
          if (field === 'day') {
            dobState.day = value;
            document.getElementById('dobDayText').textContent = parseInt(value);
            document.getElementById('dobDayOptions').classList.remove('show');
            // Update active state
            document.querySelectorAll('#dobDayOptions .custom-dropdown-option').forEach(opt => {
              opt.classList.toggle('active', opt.textContent.trim() === String(parseInt(value)));
            });
          } else if (field === 'month') {
            dobState.month = value;
            document.getElementById('dobMonthText').textContent = monthShortNames[parseInt(value) - 1];
            document.getElementById('dobMonthOptions').classList.remove('show');
            // Update active state
            const monthFullNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
            const selectedMonthName = monthFullNames[parseInt(value) - 1];
            document.querySelectorAll('#dobMonthOptions .custom-dropdown-option').forEach(opt => {
              opt.classList.toggle('active', opt.textContent.trim() === selectedMonthName);
            });
          } else if (field === 'year') {
            dobState.year = value;
            document.getElementById('dobYearText').textContent = value;
            document.getElementById('dobYearOptions').classList.remove('show');
            // Update active state
            document.querySelectorAll('#dobYearOptions .custom-dropdown-option').forEach(opt => {
              opt.classList.toggle('active', opt.textContent.trim() === String(value));
            });
          }

          // Sync hidden input
          if (dobState.day && dobState.month && dobState.year) {
            document.getElementById('dobHiddenInput').value = `${dobState.year}-${dobState.month}-${dobState.day}`;
          }
        }
      </script>

      <script>
        const profileImageInput = document.getElementById('profileImage');
        const avatarPreview = document.getElementById('avatarPreview');
        const avatarPlaceholder = document.getElementById('avatarPlaceholder');

        const imageUploadError = document.getElementById('imageUploadError');

        profileImageInput.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file) {
            if (file.size > 5 * 1024 * 1024) {
              imageUploadError.textContent = 'Profile image is too large. Choose a different image.';
              imageUploadError.style.display = 'block';
              profileImageInput.value = '';
              return;
            }
            imageUploadError.style.display = 'none';
            const reader = new FileReader();
            reader.onload = (e) => {
              avatarPreview.src = e.target.result;
              avatarPreview.style.display = 'block';
              if (avatarPlaceholder) avatarPlaceholder.style.display = 'none';
            };
            reader.readAsDataURL(file);
          }
        });


        const editProfileForm = document.getElementById('editProfileForm');
        const submitBtn = editProfileForm.querySelector('.btn-save');
        let isSubmitting = false;

        editProfileForm.addEventListener('submit', (e) => {
          if (window.ELSHValidator && !window.ELSHValidator.validateForm(editProfileForm, ['fullName', 'phone'])) {
            e.preventDefault();
            return;
          }

          if (isSubmitting) {
            e.preventDefault();
            return;
          }
          isSubmitting = true;
          submitBtn.textContent = 'PROCESSING...';
          submitBtn.style.opacity = '0.7';
        });
      </script>
      <script src="/js/validation.js"></script>

</body>

</html>