<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELSH | My Profile</title>

  <link rel="stylesheet" href="/css/user/profile.css" />
</head>

<body>

  <%- include('../partials/home-navbar') %>
  <%- include('../partials/breadcrumbs') %>

    <div class="profile-wrapper">

      <!-- Page Header -->
      <div class="profile-page-header">
        <h1>My Profile</h1>
        <p>Manage your personal information and account preferences.</p>
      </div>

      <% if (locals.success) { %>
        <div class="auth-success" style="margin-bottom: 24px;">
          <%= locals.success %>
        </div>
        <% } %>

          <!-- Profile Card -->
          <div class="profile-card">

            <!-- Profile Top -->
            <div class="profile-top">
              <div class="profile-avatar">
                <% if (user.profileImage) { %>
                  <img src="<%= user.profileImage %>" alt="Profile" />
                  <% } else { %>
                    <div class="avatar-placeholder">
                      <%= user.fullName.charAt(0).toUpperCase() %>
                    </div>
                    <% } %>
              </div>

              <div class="profile-info">
                <h2>
                  <%= user.fullName %>
                </h2>

                <div class="profile-meta">
                  <span class="member-since">
                    MEMBER SINCE
                    <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long' , year: 'numeric'
                      }).toUpperCase() %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Profile Details -->
            <div class="profile-details">

              <!-- Personal Information -->
              <div class="details-section">
                <h3>PERSONAL INFORMATION</h3>

                <div class="detail-item">
                  <label>FULL NAME</label>
                  <p>
                    <%= user.fullName %>
                  </p>
                </div>

                <div class="detail-item">
                  <label>EMAIL ADDRESS</label>
                  <p>
                    <%= user.email %>
                  </p>
                </div>

                <div class="detail-item">
                  <label>PHONE NUMBER</label>
                  <p>
                    <%= user.phone || '—' %>
                  </p>
                </div>
              </div>

              <!-- Account Information -->
              <div class="details-section">
                <h3>ACCOUNT INFORMATION</h3>

                <div class="detail-item-row">
                  <label>ACCOUNT STATUS</label>
                  <span class="status-active">● Active</span>
                </div>

                <div class="detail-item-row">
                  <label>EMAIL VERIFIED</label>
                  <img src="/images/icons/user/circle-check.svg" alt="Email Verified" class="verification-icon" />
                </div>

              </div>

              <!-- Refer & Earn -->
              <div class="details-section">
                <h3>REFER & EARN</h3>
                
                <div class="detail-item" style="margin-bottom: 24px;">
                  <p style="font-size: 13px; color: #555; margin: 0; line-height: 1.6;">
                    Invite your friends to ELSH. They get ₹50 on signup, and you get ₹100 when they complete their first order!
                  </p>
                </div>

                <div class="detail-item">
                  <label>YOUR REFERRAL CODE</label>
                  <div style="font-family: monospace; font-size: 16px; font-weight: 600; color: #2c2c2c; margin-top: 8px;">
                    <%= user.referralCode %>
                  </div>
                </div>

                <div class="detail-item">
                  <label>SHARE YOUR LINK</label>
                  <div style="display: flex; gap: 8px; margin-top: 8px;">
                    <input type="text" id="referralLink" value="https://elsh.online/signup?ref=<%= user.referralCode %>" readonly 
                           style="flex: 1; padding: 12px 16px; border: 1.5px solid #e0e0d8; border-radius: 8px; font-size: 13px; background: #fafaf7; color: #555; outline: none; box-sizing: border-box;" />
                    <button onclick="copyReferralLink()" style="padding: 0 20px; background: transparent; color: #2c2c2c; border: 1.5px solid #2c2c2c; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 11px; letter-spacing: 1.5px; transition: all 0.2s;" onmouseover="this.style.background='#2c2c2c'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='#2c2c2c';">COPY</button>
                  </div>
                </div>

              </div>

            </div>

            <script>
              function copyReferralLink() {
                const linkInput = document.getElementById('referralLink');
                linkInput.select();
                document.execCommand('copy');
                
                Swal.fire({
                  toast: true,
                  position: 'top-end',
                  icon: 'success',
                  title: 'Referral link copied to clipboard!',
                  showConfirmButton: false,
                  timer: 3000
                });
              }
            </script>

            <!-- Profile Actions -->
            <div class="profile-actions">
              <a href="/profile/edit" class="btn-edit-profile">
                EDIT PROFILE
              </a>

              <% if (!user.googleId) { %>
              <a href="/profile/change-password" class="btn-change-password">
                CHANGE PASSWORD
              </a>
              <% } %>
            </div>

          </div>
    </div>

    <%- include('../partials/footer') %>

</body>

</html>