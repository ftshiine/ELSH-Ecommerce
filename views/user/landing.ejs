<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ELSH | Skincare Designed With Purpose</title>
  <link rel="stylesheet" href="/css/user/landing.css" />
</head>
<body>

  <%- include('./partials/navbar') %>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1>Skincare Designed<br/>With Purpose.</h1>
      <p>Harnessing the potent synergy of botanical innovation and scientific precision to create intentional rituals for the discerning individual.</p>
      <div class="hero-actions">
        <a href="/signup" onclick="window.location.replace('/signup'); return false;" class="btn-primary">CREATE ACCOUNT</a>
        <a href="/login" onclick="window.location.replace('/login'); return false;" class="btn-secondary">LOGIN</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/user/hero-product.png" alt="ELSH Product" />
    </div>
  </section>

  <!-- Features Section -->
<section class="features">
  <div class="feature-card">
    <div class="feature-icon">
      <img src="/images/icons/user/botanical.svg" alt="Botanical" />
    </div>
    <h3>Botanical Innovation</h3>
    <p>We source the world's most resilient botanicals, processed through green chemistry to preserve cellular integrity and maximize results.</p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">
      <img src="/images/icons/user/personalized.svg" alt="Personalized" />
    </div>
    <h3>Personalized Rituals</h3>
    <p>Skincare is not one-size-fits-all. Our algorithm-driven consultation builds a sequence unique to your skin's biological needs.</p>
  </div>
  <div class="feature-card">
    <div class="feature-icon">
      <img src="/images/icons/user/premium.svg" alt="Premium" />
    </div>
    <h3>Premium Experience</h3>
    <p>From sensory textures to sustainable weighted glass packaging, every touchpoint is designed for a moment of essential luxury.</p>
  </div>
</section>

<!-- Ritual Journey Section -->
<section class="ritual-journey">
  <h2>Your Ritual Journey</h2>
  <div class="journey-underline"></div>
  <div class="journey-steps">
    <div class="journey-step">
      <div class="step-number">1</div>
      <h4>CREATE YOUR ACCOUNT</h4>
      <p>Join the ELSH inner circle for tailored access.</p>
    </div>
    <div class="journey-step">
      <div class="step-number">2</div>
      <h4>DISCOVER PRODUCTS</h4>
      <p>Explore our scientifically curated collections.</p>
    </div>
    <div class="journey-step">
      <div class="step-number">3</div>
      <h4>BUILD YOUR RITUAL</h4>
      <p>Receive your personalized application sequence.</p>
    </div>
    <div class="journey-step">
      <div class="step-number">4</div>
      <h4>TRACK YOUR PROGRESS</h4>
      <p>Monitor your skin's evolution over time.</p>
    </div>
  </div>
</section>

<!-- Heritage Section -->
<section class="heritage">
  <div class="heritage-image">
    <img src="/images/user/heritage.jpg" alt="ELSH Heritage" />
  </div>
  <div class="heritage-content">
    <span class="heritage-label">OUR HERITAGE</span>
    <h2>More Than Skincare</h2>
    <p>ELSH was founded on the belief that beauty is a slow, intentional practice. We reject the 'quick-fix' culture, opting instead for long-term skin health through cellular nourishment and molecular science.</p>
    <p>Our laboratory in the Swiss Alps focuses on extracting the essence of nature without compromising its purity, ensuring that every drop of ELSH is as potent as it is luxurious.</p>
    <a href="/about" class="heritage-link">LEARN MORE</a>
  </div>
</section>

<% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
<!-- Core Essentials Section -->
<section class="core-essentials">
  <div class="essentials-header">
    <div>
      <h2>Core Essentials</h2>
      <p>The foundation of every intentional ritual.</p>
    </div>
    <div class="essentials-nav">
      <button class="nav-arrow" id="prevBtn">‹</button>
      <button class="nav-arrow" id="nextBtn">›</button>
    </div>
  </div>

  <div class="carousel-wrapper">
    <div class="carousel-track" id="carouselTrack">
      <% featuredProducts.forEach(product => { 
          const defaultVariant = (product.variants && product.variants.length > 0) 
              ? product.variants[0] : null;
          const productImage = (defaultVariant && defaultVariant.images && defaultVariant.images.length > 0) 
              ? defaultVariant.images[0] : '/images/user/placeholder.png';
          const shortDesc = product.description 
              ? (product.description.length > 100 
                  ? product.description.substring(0, 100) + '...' 
                  : product.description)
              : '';
      %>
        <div class="product-card">
          <div class="product-image">
            <img src="<%= productImage %>" alt="<%= product.name %>" />
          </div>
          <h4><%= product.name %></h4>
          <p><%= shortDesc %></p>
          <a href="/login" class="product-btn">🔒 AVAILABLE AFTER LOGIN</a>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Community Section -->
<section class="community">
  <h2>Join The ELSH Community</h2>
  <p class="community-subtitle">Real voices, real skin, real transformation.</p>
  <div class="testimonials-grid">
    <div class="testimonial-card">
      <div class="stars">★★★★★</div>
      <p>"The personalized ritual has completely changed my relationship with my skin. It's no longer a chore, but a moment of peace I look forward to."</p>
      <div class="testimonial-author">
        <img src="/images/avatars/userReview.png" alt="Eleanor V." />
        <div>
          <span class="author-name">Eleanor V.</span>
          <span class="author-title">ARCHITECT</span>
        </div>
      </div>
    </div>
    <div class="testimonial-card">
      <div class="stars">★★★★★</div>
      <p>"Science-backed and truly luxurious. The Botanical Serum is the only product that has ever actually reduced my fine lines without irritation."</p>
      <div class="testimonial-author">
        <img src="/images/avatars/userReviewer.png" alt="Marcus U." />
        <div>
          <span class="author-name">Marcus U.</span>
          <span class="author-title">CREATIVE DIRECTOR</span>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('./partials/footer') %>

<script>
  const track = document.getElementById('carouselTrack');
  if (track) {
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    const cards = document.querySelectorAll('.product-card');
    const totalCards = cards.length;
    let currentIndex = 0;
    let autoScrollInterval;

    function getVisibleCards() {
      const w = window.innerWidth;
      if (w <= 768) return 1;
      if (w <= 1024) return 2;
      return 3;
    }

    function getCardWidth() {
      const card = cards[0];
      const gap = 28;
      return card.offsetWidth + gap;
    }

    function goToIndex(index) {
      const visibleCards = getVisibleCards();
      const maxIndex = Math.max(0, totalCards - visibleCards);
      if (index < 0) index = maxIndex;
      if (index > maxIndex) index = 0;
      currentIndex = index;
      track.style.transform = `translateX(-${currentIndex * getCardWidth()}px)`;
    }

    function startAutoScroll() {
      autoScrollInterval = setInterval(() => {
        goToIndex(currentIndex + 1);
      }, 3000);
    }

    function resetAutoScroll() {
      clearInterval(autoScrollInterval);
      startAutoScroll();
    }

    nextBtn.addEventListener('click', () => {
      goToIndex(currentIndex + 1);
      resetAutoScroll();
    });

    prevBtn.addEventListener('click', () => {
      goToIndex(currentIndex - 1);
      resetAutoScroll();
    });

    // Recalculate on resize
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const visibleCards = getVisibleCards();
        const maxIndex = Math.max(0, totalCards - visibleCards);
        if (currentIndex > maxIndex) currentIndex = maxIndex;
        goToIndex(currentIndex);
      }, 150);
    });

    // Touch / swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    const wrapper = document.querySelector('.carousel-wrapper');

    wrapper.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    wrapper.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) goToIndex(currentIndex + 1);
        else goToIndex(currentIndex - 1);
        resetAutoScroll();
      }
    }, { passive: true });

    // Start auto scroll
    startAutoScroll();
  }
</script>

</body>
</html>