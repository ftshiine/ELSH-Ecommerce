<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin | Page Not Found</title>
  <link rel="stylesheet" href="/css/admin/dashboard.css" />
  <style>
    body { visibility: hidden; }
    .admin-not-found {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 70vh;
      text-align: center;
    }
    .admin-not-found h1 {
      font-size: 6rem;
      color: #333;
      margin: 0;
      font-family: 'Playfair Display', serif;
    }
    .admin-not-found h2 {
      font-size: 1.5rem;
      color: #666;
      margin-top: 10px;
    }
    .admin-not-found p {
      color: #888;
      max-width: 400px;
      margin-top: 15px;
      margin-bottom: 30px;
      line-height: 1.5;
    }
    .admin-not-found a {
      padding: 10px 24px;
      background-color: #000;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 600;
      transition: background-color 0.2s;
    }
    .admin-not-found a:hover {
      background-color: #333;
    }
  </style>
</head>
<body>
  <div class="admin-not-found">
    <h1>404</h1>
    <h2>Page Not Found</h2>
    <p>The admin page you are looking for does not exist or you do not have permission to access it.</p>
    <a href="/admin/dashboard">Return to Dashboard</a>
  </div>

  <script>
    // Reveal body after CSS is parsed
    document.addEventListener("DOMContentLoaded", () => {
      document.body.style.visibility = "visible";
    });
  </script>
</body>
</html>
