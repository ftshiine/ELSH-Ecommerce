<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin | Dashboard</title>
  <link rel="stylesheet" href="/css/admin/dashboard.css" />
  <style>
  body { visibility: hidden; }
</style>
</head>
<body>

  <div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
      <%- include('../partials/topbar') %>

      <div class="page-content">
        <div class="page-header">
          <div>
            <h1>Executive Dashboard</h1>
            <p>Welcome back. Here is what's happening with ELSH today.</p>
          </div>
          <div class="header-actions">
            <button class="btn-export">Export Report</button>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-label">TOTAL REVENUE</span>
            <span class="stat-value" style="font-size: 18px; color: #999; margin-top: 8px;">Coming Soon</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">TOTAL ORDERS</span>
            <span class="stat-value" style="font-size: 18px; color: #999; margin-top: 8px;">Coming Soon</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">TOTAL PRODUCTS</span>
            <span class="stat-value"><%= totalProducts || 0 %></span>
            <span class="stat-change neutral">Live Data</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">TOTAL CUSTOMERS</span>
            <span class="stat-value"><%= typeof totalCustomers !== 'undefined' ? totalCustomers : 0 %></span>
            <span class="stat-change neutral">Live Data</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">ACTIVE COUPONS</span>
            <span class="stat-value" style="font-size: 18px; color: #999; margin-top: 8px;">Coming Soon</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">PENDING ORDERS</span>
            <span class="stat-value" style="font-size: 18px; color: #999; margin-top: 8px;">Coming Soon</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">MONTHLY SALES</span>
            <span class="stat-value" style="font-size: 18px; color: #999; margin-top: 8px;">Coming Soon</span>
          </div>
        </div>

        <!-- Revenue & Top Categories -->
        <div class="mid-grid">
          <div class="revenue-card">
            <div class="card-header">
              <h2>Revenue Overview</h2>
              <span class="dropdown">Last 30 Days ▾</span>
            </div>
            <div class="chart-placeholder">
              <p>Chart coming soon</p>
            </div>
          </div>

          <div class="categories-card">
            <div class="card-header">
              <h2>Top Categories</h2>
              <span>⋮</span>
            </div>
            <div class="coming-soon-placeholder" style="padding: 30px 20px; text-align: center; color: #666; background: #fafafa; border-radius: 8px; margin-top: 15px; border: 1px dashed #ddd;">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline><polyline points="7.5 19.79 7.5 14.6 3 12"></polyline><polyline points="21 12 16.5 14.6 16.5 19.79"></polyline><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
              <h3 style="margin-bottom: 5px; color: #333; font-weight: 500; font-size: 16px;">Coming Soon</h3>
              <p style="font-size: 13px;">Analytics module is under development.</p>
            </div>
          </div>
        </div>

        <!-- Recent Orders & Low Stock -->
        <div class="bottom-grid">
          <div class="orders-card">
            <div class="card-header">
              <h2>Recent Orders</h2>
              <a href="/admin/orders">View All Orders</a>
            </div>
            <div class="coming-soon-placeholder" style="padding: 40px; text-align: center; color: #666; background: #fafafa; border-radius: 8px; margin-top: 15px; border: 1px dashed #ddd;">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 10px;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <h3 style="margin-bottom: 5px; color: #333; font-weight: 500;">Coming Soon</h3>
              <p style="font-size: 14px;">The order management system is currently under development.</p>
            </div>
          </div>

          <div class="lowstock-card">
            <div class="card-header">
              <h2>⚠ Low Stock</h2>
            </div>
            <div class="low-stock-list" style="margin-top: 15px; display: flex; flex-direction: column; gap: 10px; max-height: 300px; overflow-y: auto;">
              <% if (typeof lowStockItems !== 'undefined' && lowStockItems.length > 0) { %>
                <% lowStockItems.forEach(item => { %>
                  <div class="low-stock-item" style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: #fff; border: 1px solid #eee; border-radius: 8px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <img src="<%= item.image %>" alt="<%= item.productName %>" style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover;">
                      <div style="display: flex; flex-direction: column;">
                        <span style="font-size: 14px; font-weight: 500; color: #333;"><%= item.productName %></span>
                        <span style="font-size: 12px; color: #666;"><%= item.variantName %></span>
                      </div>
                    </div>
                    <div style="display: flex; flex-direction: column; align-items: flex-end;">
                      <span style="font-size: 14px; font-weight: 600; color: <%= item.stock === 0 ? '#c22929' : '#b87a0f' %>;">
                        <%= item.stock %> Left
                      </span>
                      <a href="/admin/inventory?search=<%= encodeURIComponent(item.productName) %>" style="font-size: 11px; color: #5b6e51; text-decoration: none; margin-top: 4px;">Update Stock</a>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div style="padding: 20px; text-align: center; color: #666; background: #fafafa; border-radius: 8px; border: 1px dashed #ddd;">
                  <h3 style="margin-bottom: 5px; color: #333; font-weight: 500; font-size: 14px;">All Good</h3>
                  <p style="font-size: 12px;">No low stock items currently.</p>
                </div>
              <% } %>
            </div>
          </div>
        </div>

      </div>

      <div class="page-footer">
        <span>© 2024 ELSH Skincare Admin Panel</span>
        <div class="footer-links">
          <a href="#">Support</a>
          <a href="#">Docs</a>
          <a href="#">System Status</a>
        </div>
      </div>
    </div>
  </div>

<script>
  // Disable bfcache completely
  window.addEventListener('unload', () => {});

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      window.location.replace('/admin/login');
    } else {
      document.body.style.visibility = 'visible';
    }
  });
</script>

</body>
</html>