<div class="topbar">
  <button class="admin-hamburger-btn" id="adminHamburgerBtn" aria-label="Toggle Sidebar">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #2c2c2c;">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
  
  <div class="topbar-right">
    <div class="topbar-notification">
      <img src="/images/icons/admin/bell.svg" alt="Notifications" />
    </div>
  </div>
</div>

<!-- Mobile Sidebar Overlay -->
<div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div>

<script>
  const adminHamburgerBtn = document.getElementById('adminHamburgerBtn');
  const adminSidebarOverlay = document.getElementById('adminSidebarOverlay');
  const sidebar = document.querySelector('.sidebar');

  if (adminHamburgerBtn && sidebar && adminSidebarOverlay) {
    adminHamburgerBtn.addEventListener('click', () => {
      sidebar.classList.toggle('active');
      adminSidebarOverlay.classList.toggle('active');
    });

    adminSidebarOverlay.addEventListener('click', () => {
      sidebar.classList.remove('active');
      adminSidebarOverlay.classList.remove('active');
    });
  }
</script>
<script src="/js/admin/noback.js"></script>