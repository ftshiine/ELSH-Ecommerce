<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin | Offer Management</title>
  <link rel="stylesheet" href="/css/admin/layout.css" />
  <link rel="stylesheet" href="/css/admin/modal.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <% locals._adminLayoutCssLoaded = true; %>
  <style>
    /* Content Elements */
    .content-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    .content-header h1 { font-family: 'Playfair Display', serif; font-size: 24px; color: #2C3E2D; margin-bottom: 8px; }
    .content-header p { font-size: 14px; color: #666; max-width: 600px; line-height: 1.5; }
    
    /* Button Styles */
    .btn-primary { background: #556B55; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 500; font-size: 14px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: background 0.2s; }
    .btn-primary:hover { background: #455745; }
    
    /* Stats Cards */
    .stats-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px; }
    .stat-card { background: white; padding: 24px; border-radius: 12px; border: 1px solid #EAEAEA; box-shadow: 0 2px 8px rgba(0,0,0,0.02); }
    .stat-title { font-size: 12px; color: #666; font-weight: 500; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .stat-value { font-size: 28px; font-weight: 500; color: #333; }
    
    /* Table Styles */
    .content-card { background: white; border-radius: 12px; border: 1px solid #EAEAEA; overflow: hidden; }
    .card-header { padding: 24px; border-bottom: 1px solid #eaeaea; display: flex; justify-content: space-between; align-items: center; }
    .card-header h2 { font-size: 20px; font-weight: 500; color: #333; margin: 0; }
    table { width: 100%; border-collapse: collapse; }
    th { background: #F8F9FA; padding: 16px 24px; text-align: left; font-size: 11px; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid #EAEAEA; }
    td { padding: 16px 24px; border-bottom: 1px solid #EAEAEA; font-size: 14px; vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    
    /* Badges */
    .status-badge { padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600; letter-spacing: 0.5px; }
    .status-active { background: #E6F4EA; color: #1E8E3E; }
    .status-scheduled { background: #fdf3e8; color: #d68940; }
    .status-expired { background: #FCE8E6; color: #D93025; }
    .status-draft { background: #F1F3F4; color: #5F6368; }
  </style>
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/topbar') %>
      <div class="page-content">
        
        <div class="content-header">
          <div class="header-left">
            <h1>Offer Management</h1>
            <p>Create and manage promotional offers across specific products or entire categories to drive sales.</p>
          </div>
          <div class="header-actions">
            <a href="/admin/offers/create" class="btn-primary" style="text-decoration:none;">+ Create Offer</a>
          </div>
        </div>

        <div class="stats-container">
          <!-- Active Offers -->
          <div class="stat-card">
            <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
              <div style="background: #eef5ee; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #556B55;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
              </div>
            </div>
            <div class="stat-title">Active Offers</div>
            <div class="stat-value"><%= activeOffers ? activeOffers.length : 0 %> Active</div>
          </div>

          <!-- Total Scheduled -->
          <div class="stat-card">
            <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
              <div style="background: #fdf3e8; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #d68940;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </div>
            </div>
            <div class="stat-title">Scheduled Offers</div>
            <div class="stat-value"><%= scheduledDraftOffers ? scheduledDraftOffers.length : 0 %></div>
          </div>
          
          <!-- Offer Stats -->
          <div class="stat-card">
            <div style="display: flex; justify-content: space-between; margin-bottom: 16px;">
              <div style="background: #eef5ee; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #556B55;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
              </div>
            </div>
            <div class="stat-title">Average Discount</div>
            <div class="stat-value">~15%</div>
          </div>
        </div>

        <div class="content-card">
          <div class="card-header">
            <h2>All Campaigns</h2>
          </div>

          <div style="overflow-x: auto;">
            <table>
              <thead>
                <tr>
                  <th>Campaign Name</th>
                  <th>Target Type</th>
                  <th>Target Items</th>
                  <th>Discount Value</th>
                  <th>Start Date</th>
                  <th>End Date</th>
                  <th>Status</th>
                  <th style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% const allOffers = [...(activeOffers||[]), ...(scheduledDraftOffers||[])]; %>
                <% if (allOffers.length === 0) { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 40px; color: #666;">No offers found.</td>
                  </tr>
                <% } else { %>
                  <% allOffers.forEach(offer => { %>
                    <tr>
                      <td>
                        <div style="display: flex; align-items: center; gap: 12px;">
                          <% if (offer.bannerImage) { %>
                            <img src="<%= offer.bannerImage.replace(/\\/g, '/') %>" style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover; border: 1px solid #ddd;">
                          <% } else { %>
                            <div style="width: 40px; height: 40px; border-radius: 6px; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #888;">N/A</div>
                          <% } %>
                          <div>
                            <div style="font-weight: 600; color: #333;"><%= offer.name %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span style="font-size: 13px; color: #555; text-transform: capitalize;"><%= offer.targetType || 'product' %></span>
                      </td>
                      <td>
                        <div style="font-size: 13px; color: #333; max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= offer.targetType === 'category' && offer.targetCategories ? offer.targetCategories.map(c => c.name).join(', ') : (offer.targetType === 'product' && offer.targetProducts ? offer.targetProducts.map(p => p.name).join(', ') : '') %>">
                          <% if (offer.targetType === 'category' && offer.targetCategories && offer.targetCategories.length > 0) { %>
                            <%= offer.targetCategories.map(c => c.name).join(', ') %>
                          <% } else if (offer.targetType === 'product' && offer.targetProducts && offer.targetProducts.length > 0) { %>
                            <%= offer.targetProducts.map(p => p.name).join(', ') %>
                          <% } else if (offer.targetType === 'variant') { %>
                            Variant Selection (<%= offer.targetVariants ? offer.targetVariants.length : 0 %>)
                          <% } else { %>
                            N/A
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <% if(offer.discountType === 'percentage') { %>
                          <span style="display: inline-block; padding: 4px 12px; background: #f0f0f0; border-radius: 20px; font-size: 12px; font-weight: 500; color: #333;"><%= offer.discountValue %>% OFF</span>
                        <% } else { %>
                          <span style="display: inline-block; padding: 4px 12px; background: #fdf3e8; border-radius: 20px; font-size: 12px; font-weight: 500; color: #d68940;">₹<%= offer.discountValue %> OFF</span>
                        <% } %>
                      </td>
                      <td style="font-size: 13px; color: #555;">
                        <%= new Date(offer.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </td>
                      <td style="font-size: 13px; color: #555;">
                        <%= new Date(offer.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </td>
                      <td>
                        <% if (!offer.isActive) { %>
                          <span class="status-badge" style="background: #fce8e6; color: #d32f2f;">PAUSED</span>
                        <% } else { %>
                          <span class="status-badge status-<%= offer.status.toLowerCase() %>"><%= offer.status %></span>
                        <% } %>
                      </td>
                      <td style="text-align: right;">
                        <div style="display: flex; gap: 4px; justify-content: flex-end;">
                          <a href="/admin/offers/<%= offer._id %>/edit" class="action-btn" style="background: none; border: none; cursor: pointer; color: #666; padding: 8px; text-decoration: none;" title="Edit Offer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                          </a>
                          <button class="action-btn" onclick="toggleOffer('<%= offer._id %>', <%= offer.isActive %>)" style="background: none; border: none; cursor: pointer; color: #666; padding: 8px;" title="Toggle Status">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="1"></circle>
                              <circle cx="12" cy="5" r="1"></circle>
                              <circle cx="12" cy="19" r="1"></circle>
                            </svg>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>

<!-- Custom Modal -->
<div class="modal-overlay" id="customModal">
  <div class="modal-box">
    <div class="modal-icon">
      <img src="/images/icons/admin/triangle-alert.svg" alt="Alert" id="modalIcon" />
    </div>
    <h2 class="modal-title" id="modalTitle">Title</h2>
    <p class="modal-message" id="modalMessage">Message</p>
    <div class="modal-actions" id="modalActions">
      <button type="button" class="modal-btn modal-btn-cancel" id="modalCancel" onclick="closeModal()">Cancel</button>
      <button type="button" class="modal-btn modal-btn-confirm" id="modalConfirm">Confirm</button>
    </div>
  </div>
</div>

<script>
  const customModal = document.getElementById('customModal');
  const modalIcon = document.getElementById('modalIcon');
  const modalTitle = document.getElementById('modalTitle');
  const modalMessage = document.getElementById('modalMessage');
  const modalCancel = document.getElementById('modalCancel');
  const modalConfirm = document.getElementById('modalConfirm');

  function closeModal() {
    customModal.classList.remove('active');
  }

  async function toggleOffer(id, currentStatus) {
    const action = currentStatus ? 'deactivate' : 'activate';
    
    modalIcon.src = '/images/icons/admin/triangle-alert.svg';
    modalTitle.textContent = `Are you sure?`;
    modalMessage.innerHTML = `Do you want to ${action} this offer?`;
    modalConfirm.textContent = `Yes, ${action} it!`;
    
    if (action === 'deactivate') {
      modalConfirm.classList.remove('modal-btn-positive');
      modalConfirm.style.background = '#d32f2f'; // red tint
    } else {
      modalConfirm.classList.add('modal-btn-positive');
      modalConfirm.style.background = ''; // reset
    }

    modalCancel.style.display = 'inline-block';
    customModal.classList.add('active');

    modalConfirm.onclick = async () => {
      modalConfirm.disabled = true;
      modalConfirm.textContent = 'Processing...';

      try {
        const response = await fetch(`/admin/offers/${id}/toggle`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        
        if (data.success) {
          modalIcon.src = '/images/icons/admin/check-circle.svg';
          modalTitle.textContent = 'Success!';
          modalMessage.innerHTML = data.message;
          modalCancel.style.display = 'none';
          modalConfirm.textContent = 'OK';
          modalConfirm.style.background = '';
          modalConfirm.classList.add('modal-btn-positive');
          modalConfirm.disabled = false;

          modalConfirm.onclick = () => {
            location.reload();
          };
        } else {
          modalIcon.src = '/images/icons/admin/triangle-alert.svg';
          modalTitle.textContent = 'Error';
          modalMessage.innerHTML = data.message;
          modalCancel.style.display = 'none';
          modalConfirm.textContent = 'Close';
          modalConfirm.disabled = false;
          modalConfirm.style.background = '';
          modalConfirm.classList.remove('modal-btn-positive');
          modalConfirm.onclick = closeModal;
        }
      } catch (err) {
        modalIcon.src = '/images/icons/admin/triangle-alert.svg';
        modalTitle.textContent = 'Error';
        modalMessage.innerHTML = 'Something went wrong';
        modalCancel.style.display = 'none';
        modalConfirm.textContent = 'Close';
        modalConfirm.disabled = false;
        modalConfirm.style.background = '';
        modalConfirm.classList.remove('modal-btn-positive');
        modalConfirm.onclick = closeModal;
      }
    };
  }
</script>
</body>
</html>
